;;;-------------------------------------------------------------------------;;;
;;;                            Initialization                               ;;;
;;;-------------------------------------------------------------------------;;;

[?Initialize] => (Prove: addSettings("Assetto Corsa EVO", "Ford Mustang GT3",
									 [Geometry.Caster.Left, Geometry.Caster.Right])),
				 (Prove: removeSettings("Assetto Corsa EVO", "Ford Mustang GT3",
										[Electronics.Map, Aero.Wing.Front]))