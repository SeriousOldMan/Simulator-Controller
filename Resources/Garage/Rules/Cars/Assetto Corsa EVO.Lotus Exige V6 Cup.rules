;;;-------------------------------------------------------------------------;;;
;;;                            Initialization                               ;;;
;;;-------------------------------------------------------------------------;;;

[?Initialize] => (Prove: removeSettings("Assetto Corsa EVO", "Lotus Exige V6 Cup",
										[Electronics.Map, Electronics.ABS,
										 Brake.Pressure, Brake.Balance,
										 Aero.Wing.*, Aero.Height.*, AntiRollBar.*,
										 Spring.*.*.*, Bumpstop.*.*.*,
										 Damper.Compression.Fast.*.*, Damper.Rebound.Fast.*.*,
										 Differential.Preload]))