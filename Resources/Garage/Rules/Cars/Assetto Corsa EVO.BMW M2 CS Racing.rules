;;;-------------------------------------------------------------------------;;;
;;;                            Initialization                               ;;;
;;;-------------------------------------------------------------------------;;;

[?Initialize] => (Prove: removeSettings("Assetto Corsa EVO", "BMW M2 CS Racing",
										[Electronics.*,
										 Aero.Wing.Front,
										 Bumpstop.*.*.*,
										 Damper.Compression.Fast.*.*, Damper.Rebound.Fast.*.*,
										 Differential.Preload]))