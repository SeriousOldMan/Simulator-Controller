;;;-------------------------------------------------------------------------;;;
;;;                            Initialization                               ;;;
;;;-------------------------------------------------------------------------;;;

[?Initialize] => (Prove: addSimulator("RaceRoom Racing Experience")),
				 (Prove: addCharacteristics("RaceRoom Racing Experience", *, *, *)),
				 (Prove: addSettings("RaceRoom Racing Experience", *, *)),
				 (Prove: removeSettings("RaceRoom Racing Experience", *,
										[Electronics.Turbo, Electronics.MGUH.Mode,
										 Brake.Duct.Front, Brake.Duct.Rear,
										 Bumpstop.Range.Front.Left, Bumpstop.Range.Front.Right,
										 Bumpstop.Range.Rear.Left, Bumpstop.Range.Rear.Right,
										 Radiator.Blanket.Water, Radiator.Blanket.Oil,
										 Geometry.Caster.Left, Geometry.Caster.Right]))


;;;-------------------------------------------------------------------------;;;
;;;                         Setup Recommendations                           ;;;
;;;-------------------------------------------------------------------------;;;

#Include %kResourcesDirectory%Garage\Rules\Generic Recommendations.rules