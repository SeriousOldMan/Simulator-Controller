;;;-------------------------------------------------------------------------;;;
;;;                       Global Declaration Section                        ;;;
;;;-------------------------------------------------------------------------;;;

#Requires AutoHotkey >=2.0
#SingleInstance Force
#Warn
#Warn LocalSameAsGlobal, Off

SendMode("Input")
SetWorkingDir(A_ScriptDir)

global kBuildConfiguration := "Development"


;;;-------------------------------------------------------------------------;;;
;;;                         Global Include Section                          ;;;
;;;-------------------------------------------------------------------------;;;

#Include "..\Framework\Framework.ahk"
#Include "..\Framework\Extensions\SpeechSynthesizer.ahk"
#Include "AHKUnit\AHKUnit.ahk"


;;;-------------------------------------------------------------------------;;;
;;;                              Test Section                               ;;;
;;;-------------------------------------------------------------------------;;;

class GrammarCorrectionTest extends Assert {
	Russian_Test() {
		static tests := [
			["Ты отстаешь от соперника впереди на 1 секунду.", "Ты отстаешь от соперника впереди на одну секунду."],
			["Ты отстаешь от соперника впереди на 2 секунды.", "Ты отстаешь от соперника впереди на две секунды."],
			["Ты отстаешь от соперника впереди на 5 секунд.", "Ты отстаешь от соперника впереди на пять секунд."],
			["Через 1 минуту сессия закончится.", "Через одну минуту сессия закончится."],
			["Желтый флаг в 1 метре.", "Желтый флаг в одном метре."],
			["Желтый флаг в 5 метрах.", "Желтый флаг в пяти метрах."],
			["На трассе 1 машина.", "На трассе одна машина."],
			["На трассе 2 машины.", "На трассе две машины."],
			["На трассе 5 машин.", "На трассе пять машин."],
			["На трассе 21 машина.", "На трассе двадцать одна машина."],
			["На трассе 22 машины.", "На трассе двадцать две машины."],
			["Мощно, отыграли 1 позицию.", "Мощно, отыграли одну позицию."],
			["Мощно, отыграли 2 позиции.", "Мощно, отыграли две позиции."],
			["Чёрт, потеряли 21 позицию.", "Чёрт, потеряли двадцать одну позицию."],
			["У тебя осталось 1 литр.", "У тебя остался один литр."],
			["У тебя осталось 2 литра.", "У тебя осталось два литра."],
			["У тебя осталось 21 литр.", "У тебя остался двадцать один литр."],
			["У нас запланировано 1 пит-стоп.", "У нас запланирован один пит-стоп."],
			["У нас запланировано 2 пит-стопа.", "У нас запланировано два пит-стопа."],
			["Передний левый — еще 82 процентов.", "Передний левый — еще восемьдесят два процента."],
			["Воздух около 2 градусов.", "Воздух около двух градусов."],
			["Температура воды — 1 градус.", "Температура воды — один градус."],
			["Твой текущий круг — 3 минуты 35 запятая 9 секунды.", "Твой текущий круг — три минуты тридцать пять запятая девять секунды."],
			["Отрыв от машины сзади сейчас 2 запятая 5 секунды.", "Отрыв от машины сзади сейчас две запятая пять секунды."],
			["Отрыв от машины сзади сейчас 1 запятая 1 секунды.", "Отрыв от машины сзади сейчас одна запятая одна секунды."],
			["Я смоделировал 21 вариант пит-стопа.", "Я смоделировал двадцать один вариант пит-стопа."],
			["Я смоделировал 1 вариант пит-стопа.", "Я смоделировал один вариант пит-стопа."],
			["У тебя впереди еще 1 круг.", "У тебя впереди еще один круг."],
			["У тебя впереди еще 2 круга.", "У тебя впереди еще два круга."],
			["У тебя впереди еще 5 кругов.", "У тебя впереди еще пять кругов."],
			["У тебя впереди еще 11 кругов.", "У тебя впереди еще одиннадцать кругов."],
			["У тебя впереди еще 21 круг.", "У тебя впереди еще двадцать один круг."],
			["У тебя впереди еще 22 круга.", "У тебя впереди еще двадцать два круга."],
			["У тебя впереди еще 101 круг.", "У тебя впереди еще сто один круг."],
			["У тебя впереди еще 111 кругов.", "У тебя впереди еще сто одиннадцать кругов."],
			["Раскрути мотор до 7900 оборотов.", "Раскрути мотор до семи тысяч девятисот оборотов."],
			["У тебя осталось 1 галлон.", "У тебя остался один галлон."],
			["Можешь заезжать на 1-м круге.", "Можешь заезжать на 1-м круге."]
		]

		for ignore, test in tests
			this.AssertEqual(test[2], SpeechSynthesizer.correctRUGrammar(test[1]), "Grammar correction failed...")
	}

	English_Test() {
		static tests := [
			["We have run 1 laps", "We have run 1 lap"],
			["We have run 2 lap", "We have run 2 laps"]
		]

		for ignore, test in tests
			this.AssertEqual(test[2], SpeechSynthesizer.correctENGrammar(test[1]), "Grammar correction failed...")
	}

	German_Test() {
		static tests := [
			["Wir sind 1 Runden gefahren", "Wir sind 1 Runde gefahren"],
			["Wir sind 2 Runde gefahren", "Wir sind 2 Runden gefahren"]
		]

		for ignore, test in tests
			this.AssertEqual(test[2], SpeechSynthesizer.correctDEGrammar(test[1]), "Grammar correction failed...")
	}
}


;;;-------------------------------------------------------------------------;;;
;;;                         Initialization Section                          ;;;
;;;-------------------------------------------------------------------------;;;

AHKUnit.AddTestClass(GrammarCorrectionTest)

AHKUnit.Run()